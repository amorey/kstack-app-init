{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kstack-app",
  "version": "0.1.0",
  "identifier": "sh.kstack.desktop",
  "build": {
    "beforeDevCommand": "make sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "make sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "kstack-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["kstack"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/kstack-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "entitlements.plist"
    }
  }
}
