<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WKWebView JavaScriptCore needs a writable, executable JIT region. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>

	<!--
	  The Go sidecar is built separately and embedded via Tauri externalBin.
	  Without this, the hardened runtime refuses to exec a binary it did not
	  see signed under the same Team as part of the app.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!--
	  Outbound network: the OAuth loopback flow and (transitively, via the
	  sidecar process) the kstack cloud connection.
	-->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
