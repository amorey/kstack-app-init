# Cluster data — what a ClusterCache holds: the discovered kind catalog and the
# cached Kubernetes objects and Events themselves. Every entry point is keyed by
# parent cluster `id` + `cacheID`, and every frame carries its cache provenance so
# a client can reject stragglers from a superseded cache.

"""
One kind a cluster's API server advertises, from `/apis` discovery (built-ins +
CRDs). The dashboard builds its dynamic resource nav from these: `resource` dedupes
against the curated catalog and `apiVersion`'s group buckets the kind into a nav
group.
"""
type ClusterDataKind {
  "Group/version, e.g. \"apps/v1\", or \"v1\" for the core group."
  apiVersion: String!
  "Kind name, e.g. \"Deployment\"."
  kind: String!
  "Plural lowercase resource name (the URL form), e.g. \"deployments\"."
  resource: String!
  "\"Namespaced\" or \"Cluster\"."
  scope: String!
  "True when this kind is backed by a CustomResourceDefinition."
  isCRD: Boolean!
  "Number of objects of this kind currently in the cache (0 for an advertised-but-empty kind)."
  count: Int!
}

"""
One cached Kubernetes Event from a cluster's synced data (the raw `events.k8s.io`/core
Event, read from the active cache). Powers the dashboard's events table. Distinct from
`Event`, which is kstack's own control-plane timeline for a Cluster/ClusterCache — this
is data synced *from* the cluster. The involved-object identity is flattened onto the
record; the raw event body is not exposed.
"""
type ClusterDataEvent {
  "The Event's own object UID — the stable identity the watch keys on."
  uid: String!
  """
  Severity — conventionally `Normal` or `Warning`, but an **open string** (not the
  closed `EventType` enum): Kubernetes does not constrain `Event.type`, so a cluster may
  omit it (empty) or supply a custom value, which is passed through verbatim.
  """
  type: String!
  "CamelCase machine reason, e.g. \"BackOff\" (empty if the Event carried none)."
  reason: String!
  "Human-readable detail (empty if none)."
  message: String!
  "How many times the event has fired (coalesced series count; >= 1)."
  count: Int!
  "First occurrence time, or null when the source Event carried no timestamp."
  firstSeen: Time
  "Latest occurrence time, or null when the source Event carried no timestamp."
  lastSeen: Time
  "Kind of the object the event is about, e.g. \"Pod\" (empty if unset)."
  involvedKind: String!
  "Namespace of the involved object (empty for a cluster-scoped or name-only reference)."
  involvedNamespace: String!
  "Name of the involved object (empty if unset)."
  involvedName: String!
}

"""
One cached Kubernetes object projected for a table row (any kind), read from the
active cache. Only the universal identity is typed for now (`uid`/`apiVersion`/`kind`/
`namespace`/`name`/`creationTimestamp`) — enough to key the watch, sort, and render a
Name/Namespace/Age table. The nested object body (and kind-specific columns computed
from it) is deferred to a follow-up: see the "ClusterDataObject — native nested body"
item in `TODO.md`. Distinct from `ClusterDataEvent`, which is one specific kind with its
own fully-typed shape.
"""
type ClusterDataObject {
  "The object's UID — the stable identity the watch keys on."
  uid: String!
  "The object's group/version, e.g. \"apps/v1\", or \"v1\" for the core group."
  apiVersion: String!
  "Kind name, e.g. \"Deployment\"."
  kind: String!
  "Namespace; empty for a cluster-scoped kind."
  namespace: String!
  "Object name."
  name: String!
  "creationTimestamp — drives the universal Age column; null when the source object carried none."
  creationTimestamp: Time
  "Full native body as JSON, verbatim from the cache (managedFields and the kubectl last-applied annotation stripped); resolver-gated, so an identity-only consumer skips the body cost."
  rawJSON: JSON
}

"One change on the `clusterDataKindsWatch` stream: the affected kind, what happened to it, and which cache it came from."
type ClusterDataKindChange {
  "Whether this kind was added (incl. the on-subscribe snapshot), modified (chiefly a `count` change), or deleted."
  type: ChangeType!
  "The affected kind. On `Deleted`, its last-known row; the client keys on `apiVersion` + `resource`. Null on `Bookmark`."
  kind: ClusterDataKind
  """
  The cache this frame came from — the frame's provenance. A client watching the
  active cache rejects a late frame from a superseded cache (one still draining
  after a cache/context switch) by comparing this against the cache it subscribed for.
  """
  cacheID: ObjectID!
}

"One change on the `clusterDataEventsWatch` stream: the affected event, what happened to it, and which cache it came from."
type ClusterDataEventChange {
  "Whether this event was added (incl. the on-subscribe snapshot), modified (chiefly a `count`/`lastSeen` change as it re-fires), or deleted."
  type: ChangeType!
  "The affected event. On `Deleted`, its last-known row; the client keys on `uid`. Null on `Bookmark`."
  event: ClusterDataEvent
  """
  The cache this frame came from — the frame's provenance, mirroring
  `ClusterDataKindChange.cacheID`. A client watching the active cache rejects a late
  frame from a superseded cache by comparing this against the cache it subscribed for.
  """
  cacheID: ObjectID!
}

"One change on the `clusterDataObjectsWatch` stream: the affected object, what happened to it, and the (cache, kind) this frame came from."
type ClusterDataObjectChange {
  "Whether this object was added (incl. the on-subscribe snapshot), modified, or deleted."
  type: ChangeType!
  "The affected object. On `Deleted`, its last-known row; the client keys on `uid`. Null on `Bookmark`."
  object: ClusterDataObject
  """
  The cache this frame came from — the frame's provenance, mirroring
  `ClusterDataKindChange.cacheID`. A client watching the active cache rejects a late
  frame from a superseded cache by comparing this against the cache it subscribed for.
  """
  cacheID: ObjectID!
  """
  The kind this frame is for — the watch's `(apiVersion, resource)`. Unlike the kinds/
  events watches (whose variables carry no kind, so `cacheID` is complete provenance),
  this watch is keyed by kind too, so a client switching resources *within one cache*
  uses these to reject a straggler from the previous kind's still-draining subscription.
  """
  apiVersion: String!
  resource: String!
}

extend type Query {
  """
  The kinds a cluster's API server advertises (from `/apis` discovery), read from one
  ClusterCache's catalog (`id` = parent cluster, `cacheID` = the cache — typically the
  active one). Used to build the dashboard's dynamic resource nav. Empty for a cache
  that has not synced yet. Read on demand (per active cache), not streamed.
  """
  clusterDataKinds(id: ObjectID!, cacheID: ObjectID!): [ClusterDataKind!]!
}

extend type Subscription {
  """
  Streams one ClusterCache's discovered kind catalog as a Kubernetes-style delta
  watch (the live counterpart of `clusterDataKinds`, keyed the same way — parent
  cluster `id` + `cacheID`): the current catalog as an `Added` burst on subscribe,
  closed by one `Bookmark`; then one `Added`/`Modified`/`Deleted` change per kind as the sync engine writes
  objects — a kind's per-object `count` is live, so an object write re-emits it as
  `Modified`. The client keys each kind by `apiVersion` + `resource` and rebuilds the
  dashboard resource nav from the accumulated set, so the nav (kinds + counts) tracks
  the cluster in real time. Empty (no frames) until that cache's db is open (a
  never-synced / paused cache streams nothing until it syncs).
  """
  clusterDataKindsWatch(id: ObjectID!, cacheID: ObjectID!): ClusterDataKindChange!

  """
  Streams one ClusterCache's cached Kubernetes Events as a Kubernetes-style delta watch,
  keyed like `clusterDataKindsWatch` (parent cluster `id` + `cacheID`): the newest window
  of events as an `Added` burst on subscribe, closed by one `Bookmark`; then one `Added`/`Modified`/`Deleted` change
  per event as the sync engine writes events (a re-firing event bumps its `count`/`lastSeen`
  → `Modified`). The client keys each event by `uid` and maintains the table from the
  accumulated set. Because the window is bounded, an event aging out of it as newer events
  arrive surfaces as `Deleted`. Empty (no frames) until that cache's db is open (a
  never-synced / paused cache streams nothing until it syncs). Distinct from
  `clusterEventsWatch`, which streams kstack's own control-plane timeline.
  """
  clusterDataEventsWatch(id: ObjectID!, cacheID: ObjectID!): ClusterDataEventChange!

  """
  Streams one kind's cached objects from a ClusterCache as a Kubernetes-style delta
  watch, keyed like `clusterDataEventsWatch` plus the target kind (`apiVersion` +
  `resource`, e.g. `"apps/v1"` + `"deployments"`): the current object set for the kind
  as an `Added` burst on subscribe (the snapshot), closed by one `Bookmark`; then one `Added`/`Modified`/`Deleted`
  change per object as the sync engine writes it, each frame carrying its `cacheID`
  provenance. The client keys each object by `uid` and maintains the table from the
  accumulated set. Empty (no frames) until that cache's db is open and the kind has
  synced (a never-synced / paused cache streams nothing until it syncs), mirroring
  `clusterDataEventsWatch`'s posture.
  """
  clusterDataObjectsWatch(id: ObjectID!, cacheID: ObjectID!, apiVersion: String!, resource: String!): ClusterDataObjectChange!
}
