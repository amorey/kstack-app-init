# Kstack App Sidecar GraphQL schema

# --- Cluster cache ---

"A cluster in the app's local registry. `uuid` is the cluster's `kube-system` namespace UID — stable across kubeconfig context renames and unique per cluster. A cluster stays listed even after it leaves the kubeconfig (so its cache can be inspected or cleaned up); the `present`/`cached`/`enabled` flags describe its current state."
type Cluster {
  uuid: String!
  name: String!
  context: String!
  "True when this entry matches the kubeconfig's `current-context`."
  isCurrent: Boolean!
  "Whether the user has syncing enabled for this cluster. Disabling freezes its cache (no longer browsable)."
  enabled: Boolean!
  "True while the cluster's kube-context is present in the current kubeconfig."
  present: Boolean!
  "True when a local SQLite cache exists on disk for this cluster."
  cached: Boolean!
  "On-disk size of the cache (sqlite + WAL/shm sidecars) in bytes; 0 when not cached."
  cacheBytes: Int!
  "Unix-millis of the last time the cache received fresh data; 0 if never."
  lastSyncedAt: Int!
  "Unix-millis of the last time this cluster's context was seen in the kubeconfig; 0 if never."
  lastSeenInKubeconfigAt: Int!
}

"A single cached pod from a cluster's local SQLite mirror. `clusterUuid` identifies which cluster this row belongs to; all other fields mirror the underlying object."
type Pod {
  clusterUuid: String!
  namespace: String!
  name: String!
  uid: String!
  phase: String!
  nodeName: String!
  updatedAt: Int!
}

"A cached Service. Mirrors the columns in the local SQLite mirror."
type Service {
  clusterUuid: String!
  namespace: String!
  name: String!
  uid: String!
  type: String!
  clusterIp: String!
  updatedAt: Int!
}

"A cached Deployment. Replica counts are the spec'd vs ready values."
type Deployment {
  clusterUuid: String!
  namespace: String!
  name: String!
  uid: String!
  replicas: Int!
  readyReplicas: Int!
  updatedAt: Int!
}

"A cached Node. `ready` is true when the node has a Ready=True condition."
type Node {
  clusterUuid: String!
  name: String!
  uid: String!
  ready: Boolean!
  updatedAt: Int!
}

"A cached Kubernetes Event. Mirrors the dedicated `events` table; ordered by lastSeen DESC when listed."
type Event {
  clusterUuid: String!
  uid: String!
  type: String!
  reason: String!
  message: String!
  involvedKind: String!
  involvedNamespace: String!
  involvedName: String!
  firstSeen: Int!
  lastSeen: Int!
  count: Int!
}

input ChatMessageInput {
  role: String!
  content: String!
}

input ChatInput {
  messages: [ChatMessageInput!]!
}

"Streaming chat chunk. `delta` is the next piece of assistant text; `done` is true on the final frame (delta may be empty)."
type ChatChunk {
  delta: String!
  done: Boolean!
}

# --- Cloud account ---

"The verified identity of the signed-in user, from the OIDC ID-token claims."
type Identity {
  sub: String!
  email: String!
  name: String!
}

"A snapshot of the user's authentication state. `authenticated` is the explicit sign-in signal; `identity` carries the verified claims and is non-null only when `authenticated` is true."
type AuthState {
  authenticated: Boolean!
  identity: Identity
}

# --- KubeConfig ---

# https://pkg.go.dev/k8s.io/client-go/tools/clientcmd/api#Config
type KubeConfig {
  authInfos: [KubeConfigAuthInfo!]!
  clusters: [KubeConfigCluster!]!
  contexts: [KubeConfigContext!]!
  currentContext: String!
  extensions: KubeConfigExtensions
}

# https://pkg.go.dev/k8s.io/client-go/tools/clientcmd/api#AuthInfo
type KubeConfigAuthInfo {
  name: String!
  locationOfOrigin: String!
  extensions: KubeConfigExtensions
}

# https://pkg.go.dev/k8s.io/client-go/tools/clientcmd/api#Cluster
type KubeConfigCluster {
  name: String!
  locationOfOrigin: String!
  server: String!
  extensions: KubeConfigExtensions
}

# https://pkg.go.dev/k8s.io/client-go/tools/clientcmd/api#Context
type KubeConfigContext {
  name: String!
  locationOfOrigin: String!
  cluster: String!
  authInfo: String!
  namespace: String!
  extensions: KubeConfigExtensions
}

type KubeConfigWatchEvent {
  type: WatchEventType!
  object: KubeConfig
}

scalar KubeConfigExtensions

# --- Watch ---

# https://pkg.go.dev/k8s.io/apimachinery/pkg/watch#EventType
enum WatchEventType {
  ADDED
  MODIFIED
  DELETED
  BOOKMARK
  ERROR
}

# --- Root operations ---

type Query {
  "Health-check field. Always returns 'pong'."
  ping: String!

  "Every cluster in the local registry — those in the current kubeconfig plus any with a leftover cache. Sorted by name."
  clusters: [Cluster!]!

  "Snapshot of pods cached for the given cluster, ordered by namespace then name."
  pods(clusterUuid: String!): [Pod!]!

  "Snapshot of services cached for the given cluster."
  services(clusterUuid: String!): [Service!]!

  "Snapshot of deployments cached for the given cluster."
  deployments(clusterUuid: String!): [Deployment!]!

  "Snapshot of nodes cached for the given cluster."
  nodes(clusterUuid: String!): [Node!]!

  "Recent Kubernetes events from the local mirror, newest first. `limit` defaults to 100 and is capped at 500."
  events(clusterUuid: String!, limit: Int): [Event!]!

  "The current authentication state (signed-in flag + identity). Signed-out when no cloud account is configured. Live updates arrive via the authStateWatch subscription."
  authState: AuthState!
}

type Mutation {
  "Sets the kubeconfig current-context, persisting it to disk (kubectl-visible). Returns true on success; errors if the context is unknown. The updated config is delivered to clients via the kubeConfigWatch subscription."
  setCurrentContext(name: String!): Boolean!

  "Enable or disable syncing for a cluster. Disabling stops its sync and freezes its cache (no longer browsable); enabling resumes it. Returns the updated cluster; errors if the uuid is unknown."
  setClusterEnabled(uuid: String!, enabled: Boolean!): Cluster!

  "Delete a cluster's local cache files, keeping its registry row (now uncached). If its context is still present and enabled it re-syncs from scratch; otherwise the files are simply freed and the row — including an orphan — stays listed. Returns true; errors if the uuid is unknown."
  deleteClusterCache(uuid: String!): Boolean!

  "Forget a cluster entirely: delete its cache files and remove its row from the local registry (app.db). Meant for an orphan (gone from the kubeconfig); a still-present context is re-discovered on the next reconcile. Returns true; errors if the uuid is unknown."
  removeCluster(uuid: String!): Boolean!

  "Start the sidecar-owned browser sign-in (OAuth). The setup phase (bind the loopback redirect listener, open the browser) runs synchronously, so a setup failure — or no cloud account configured — is returned as an error. Returns true once the browser has been launched; the slow token exchange then completes in the background and the resulting signed-in state is delivered via the authStateWatch subscription."
  startLogin: Boolean!

  "Sign out: clear the local credentials, broadcast signed-out, and revoke the token server-side (best-effort). Returns true. No-op on a service without a cloud account."
  logout: Boolean!
}

type Subscription {
  "Emits an incrementing integer (starting at 1) every second. Cancelled when the client unsubscribes."
  tick: Int!

  "Streams the cluster registry: the full snapshot first, then a fresh snapshot on every change (discovery, enable/disable, sync freshness, deletion)."
  clustersWatch: [Cluster!]!

  "Streams the assistant's reply token-by-token. Completes after a frame with `done: true`."
  chatStream(input: ChatInput!): ChatChunk!

  "Streams the cluster's pod list: snapshot first, then a fresh snapshot every time the local cache changes."
  podsWatch(clusterUuid: String!): [Pod!]!

  "Streams the cluster's service list, same shape as podsWatch."
  servicesWatch(clusterUuid: String!): [Service!]!

  "Streams the cluster's deployment list."
  deploymentsWatch(clusterUuid: String!): [Deployment!]!

  "Streams the cluster's node list."
  nodesWatch(clusterUuid: String!): [Node!]!

  """
  KubeConfig watchers
  """
  kubeConfigWatch: KubeConfigWatchEvent

  "Streams the authentication state: the current snapshot first, then a fresh snapshot on every sign-in / sign-out / refresh-failure change."
  authStateWatch: AuthState!
}
