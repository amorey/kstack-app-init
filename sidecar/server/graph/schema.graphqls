"User-scoped preferences synced through the kstack cloud. Today this is a single free-form `placeholder` string — extend as the product grows."
type Settings {
  placeholder: String!
}

input UpdateSettingsInput {
  placeholder: String
}

"Engine connection lifecycle."
enum SyncState {
  CONNECTING
  LIVE
  BACKOFF
  OFFLINE
}

"Connection/sync health of the always-on engine that owns the single upstream connection."
type SyncStatus {
  "Engine lifecycle state."
  state: SyncState!
  "Last upstream error; empty string when healthy."
  lastError: String!
  "Unix-millis of the last successful snapshot reconcile; 0 if never synced."
  lastSyncedAt: Int!
  "Unix-millis of the next scheduled reconnect while in `backoff`; 0 otherwise."
  retryAt: Int!
}

type Query {
  "Health-check field. Always returns 'pong'."
  ping: String!

  "Returns the current user's Settings, served from the locally-reconciled store the always-on engine maintains (no synchronous cloud call)."
  settings: Settings!

  "Current sync health of the always-on engine."
  syncStatus: SyncStatus!
}

input ChatMessageInput {
  role: String!
  content: String!
}

input ChatInput {
  messages: [ChatMessageInput!]!
}

"Streaming chat chunk. `delta` is the next piece of assistant text; `done` is true on the final frame (delta may be empty)."
type ChatChunk {
  delta: String!
  done: Boolean!
}

type Mutation {
  "Write-through update: pushed to the cloud, then published locally; the engine persists it when the cloud echoes it back."
  updateSettings(input: UpdateSettingsInput!): Settings!
}

type Subscription {
  "Emits an incrementing integer (starting at 1) every second. Cancelled when the client unsubscribes."
  tick: Int!

  "Streams Settings updates: the current snapshot first, then live changes fanned out from the engine's shared hub."
  settingsWatch: Settings!

  "Streams the engine's sync health: the current status first, then every transition."
  syncStatusWatch: SyncStatus!

  "Streams the assistant's reply token-by-token. Completes after a frame with `done: true`."
  chatStream(input: ChatInput!): ChatChunk!
}
